table 'Test Results'
	lineageTag: eaef1a5b-f638-49b7-984e-c6d0b237d752

	/// Total number of production tests in the current filter context.
	measure 'Total Tests' = COUNTROWS('Test Results')
		formatString: #,##0
		lineageTag: f265f5b5-0ec3-4652-96a4-b2737e596573

	/// Tests that passed on the first attempt.
	measure 'Passed Units' = SUM('Test Results'[Pass Count])
		formatString: #,##0
		lineageTag: 36e670ad-1c82-4543-9b72-50c6c4a630e6

	/// Tests that failed on the first attempt.
	measure 'Failed Units' = SUM('Test Results'[Fail Count])
		formatString: #,##0
		lineageTag: 59a9fc63-14ec-46d6-b463-112c45bcd85d

	/// First-pass yield: passed tests divided by all tests.
	measure 'First Pass Yield %' = DIVIDE([Passed Units], [Total Tests])
		formatString: 0.00%
		lineageTag: 01c2c495-2f74-45df-8cc1-c48f45381054

	/// Defect rate: failed tests divided by all tests.
	measure 'Defect Rate %' = DIVIDE([Failed Units], [Total Tests])
		formatString: 0.00%
		lineageTag: 7a21af7b-a5a2-4eb5-8c10-470bbaf7f642

	/// Mean observed cycle time in seconds.
	measure 'Average Cycle Time' = AVERAGE('Test Results'[Cycle Time Seconds])
		formatString: 0.0 "s"
		lineageTag: 5b7e2487-961f-4d8f-b21a-cf218cb90782

	/// Share of tests completed at or below station target cycle time.
	measure 'Cycle Target Attainment %' = DIVIDE(CALCULATE([Total Tests], FILTER('Test Results', 'Test Results'[Cycle Time Seconds] <= 'Test Results'[Target Cycle Seconds])), [Total Tests])
		formatString: 0.00%
		lineageTag: 5ab5a16f-c41a-4aa5-9f00-77e51b6ac38c

